
# 이 파일을 복사해서 .env 로 만드세요: cp .env.example .env
# .env 자체는 절대 커밋하지 마세요 (.gitignore에 포함되어 있음).
#
# DB는 로컬 컨테이너가 아니라 같은 docker_bridge 네트워크의 별도 DB 컨테이너입니다.
 
# 1) 인트라넷 자체 DB (intranet_db)
DB_HOST=172.20.0.2      # db 서버 ip
DB_NAME=intranet_db
DB_USER=intre_admin
DB_PASS=zhfldk26#
 
# 2) 씨네나잇 회원 DB (ott) — 같은 서버, 같은 포트(3306), DB명만 다름
MEMBER_DB_HOST=172.20.0.2   # db 서버 ip
MEMBER_DB_PORT=3306
MEMBER_DB_NAME=ott
MEMBER_DB_USER=ott_admin
MEMBER_DB_PASS=zhfldk26#
 
# 3) 씨네나잇 웹서버(config/intranet.php)와 반드시 동일해야 하는 마스터 토큰
INTRANET_API_MASTER_TOKEN=local-test-token-change-me
 
# 4) 사내 메일 서버(윈도우 메일 서버, IMAP) 연동 설정 - 수신(읽기)
MAIL_HOST=192.168.10.10
MAIL_PORT=993
MAIL_ENCRYPTION=ssl
MAIL_VALIDATE_CERT=false

# 5) 사내 메일 서버 SMTP 연동 설정 - 발신(메일 쓰기)
# 보통 MAIL_HOST와 같은 서버지만 포트/암호화 방식이 다름 (587+STARTTLS 또는 465+SSL)
SMTP_HOST=192.168.10.10
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_VALIDATE_CERT=false

# 6) 보낸 메일을 저장할 IMAP 폴더 이름 (서버마다 다를 수 있음, hMailServer 기본값 'Sent')
MAIL_SENT_FOLDER=Sent
 
