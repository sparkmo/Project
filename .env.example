# 이 파일을 복사해서 .env 로 만드세요: cp .env.example .env
# .env 자체는 절대 커밋하지 마세요 (.gitignore에 포함되어 있음).
#
# 아래 기본값은 "docker-compose.yml에 있는 로컬 intranet-db/member-db 컨테이너"
# 기준으로 이미 맞춰져 있어서, 별도 수정 없이 바로 docker compose up 하면 됩니다.
# 실제 운영 DB 서버가 준비되면, 각 항목 아래 주석 처리된 "운영값" 쪽으로 바꾸세요.

# 1) 인트라넷 자체 DB
#    로컬(docker-compose intranet-db 컨테이너):
DB_HOST=intranet-db
DB_NAME=intranet_db
DB_USER=roror
DB_PASS=rororpass
#    운영값 예시 (실 서버 준비되면 교체):
# DB_HOST=localhost
# DB_PASS=여기에_실제_비밀번호

# 2) 씨네나잇 회원 DB
#    로컬(docker-compose member-db 컨테이너, 컨테이너 간 통신은 기본 3306 포트 사용.
#    docker-compose의 "3308:3306"은 호스트 -> 컨테이너 매핑일 뿐입니다):
MEMBER_DB_HOST=member-db
MEMBER_DB_PORT=3306
MEMBER_DB_NAME=member_db
MEMBER_DB_USER=member_admin
MEMBER_DB_PASS=memberpass
#    운영값 예시 (별도 DB 서버, 3308 포트로 실제 접속할 때):
# MEMBER_DB_HOST=172.16.0.10
# MEMBER_DB_PORT=3308
# MEMBER_DB_PASS=여기에_실제_비밀번호

# 3) 씨네나잇 웹서버(config/intranet.php)와 반드시 동일해야 하는 마스터 토큰
#    참고: env로 관리해도 웹쉘(RCE)로 뚫리면 getenv()로 그대로 조회 가능하므로
#    이 시나리오에서 실질적 방어가 되지 않습니다 (VULN-HIGH-4).
INTRANET_API_MASTER_TOKEN=local-test-token-change-me

# 4) 사내 메일 서버(윈도우 메일 서버, IMAP) 연동 설정
#    로그인 아이디는 직원의 회사 이메일(intranet_db.employee.email)을 그대로 사용하고,
#    비밀번호는 DB에 저장하지 않고 로그인 시 세션에만 잠시 보관합니다.
#    로컬에 이 메일 서버가 없으면 mail/*.php 기능만 "연동 모듈 없음" 에러가 뜨고,
#    나머지 기능(로그인/공지/회원/영상 관리)은 정상 동작합니다.
MAIL_HOST=192.168.20.20
MAIL_PORT=993
MAIL_ENCRYPTION=ssl
MAIL_VALIDATE_CERT=false
